APP_NAME=Sismo Platform API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=
# Supabase Session Pooler values (host ends in .pooler.supabase.com, port 5432).
# Set all five values together. Password is passed separately, no URI encoding needed.
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Optional legacy alternative: use the complete Session Pooler URI instead of DB_*.
SUPABASE_DATABASE_URL=
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_API_BASE_URL=
# Used only by the local PostgreSQL container in Docker Compose; blank uses local defaults.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
JWT_SECRET_KEY=local-development-only-change-before-deployment
ACCESS_TOKEN_MINUTES=30
SESSION_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_PASSWORD=
ALERT_WEBHOOK_URL=https://webhook.site/95fe3465-6391-42d2-a6c9-87a02d328372
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
IGP_LATEST_EVENT_URL=https://ultimosismo.igp.gob.pe/api/ultimo-sismo